{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile, profession, SPPG name, and role approval status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "description": "Verified email of the user."
        },
        "namaLengkap": {
          "type": "string",
          "description": "Full name of the user."
        },
        "profesi": {
          "type": "string",
          "description": "User's profession (e.g. Ahli Gizi)."
        },
        "namaSPPG": {
          "type": "string",
          "description": "Name of the SPPG associated with this user."
        },
        "noHp": {
          "type": "string",
          "description": "User's Whatsapp / Phone number."
        },
        "peran": {
          "type": "string",
          "enum": ["USER", "ADMIN"],
          "description": "Role of the user in the multi-tenant system."
        },
        "statusPersetujuan": {
          "type": "string",
          "enum": ["menunggu", "aktif", "diblokir"],
          "description": "Admin approval status."
        },
        "berakhirPada": {
          "type": "string",
          "description": "Expiration date of user access."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        },
        "loginTerakhir": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the user's last login."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user verified their email address via 6-digit OTP code."
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["pending_otp", "verified"],
          "description": "Email OTP verification status."
        },
        "emailVerifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when email verification succeeded."
        },
        "activatedBy": {
          "type": "string",
          "description": "Activation method (email_otp or admin_manual)."
        },
        "lastDeviceId": {
          "type": "string",
          "maxLength": 64,
          "description": "ID of the last device used by this user."
        },
        "lastDeviceLabel": {
          "type": "string",
          "maxLength": 160,
          "description": "Human-readable label of the user's last active device."
        }
      },
      "required": ["uid", "email"]
    },
    "DeviceSession": {
      "title": "DeviceSession",
      "description": "Tracks each connected device automatically in real time for Admin Panel visibility.",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique persistent device identifier."
        },
        "deviceType": {
          "type": "string",
          "enum": ["Mobile", "Tablet", "Desktop / Laptop"],
          "description": "Form factor of the connected device."
        },
        "deviceModel": {
          "type": "string",
          "maxLength": 100,
          "description": "Detected hardware or platform model."
        },
        "osName": {
          "type": "string",
          "maxLength": 80,
          "description": "Operating system name and version."
        },
        "browserName": {
          "type": "string",
          "maxLength": 80,
          "description": "Browser name and major version."
        },
        "screenResolution": {
          "type": "string",
          "maxLength": 40,
          "description": "Screen width x height."
        },
        "viewportSize": {
          "type": "string",
          "maxLength": 40,
          "description": "Browser viewport width x height."
        },
        "language": {
          "type": "string",
          "maxLength": 32,
          "description": "Browser language locale."
        },
        "timezone": {
          "type": "string",
          "maxLength": 80,
          "description": "Device IANA timezone."
        },
        "ipAddress": {
          "type": "string",
          "maxLength": 64,
          "description": "Network IP address observed by the server."
        },
        "userAgent": {
          "type": "string",
          "maxLength": 320,
          "description": "Trimmed browser User-Agent string."
        },
        "sessionState": {
          "type": "string",
          "enum": ["guest", "registering", "active", "demo"],
          "description": "Current session state of the device."
        },
        "userUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Associated user UID if signed in or registering."
        },
        "userEmail": {
          "type": "string",
          "maxLength": 256,
          "description": "Associated user email if signed in or registering."
        },
        "userName": {
          "type": "string",
          "maxLength": 160,
          "description": "Associated user full name."
        },
        "namaSPPG": {
          "type": "string",
          "maxLength": 160,
          "description": "Associated SPPG name."
        },
        "peran": {
          "type": "string",
          "maxLength": 32,
          "description": "Role of the user on this device."
        },
        "statusPersetujuan": {
          "type": "string",
          "maxLength": 32,
          "description": "Approval status of the user on this device."
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether the device is currently active."
        },
        "firstSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "First time this device accessed the application."
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Most recent heartbeat timestamp."
        }
      },
      "required": ["deviceId", "deviceType", "osName", "browserName", "sessionState", "lastSeenAt"]
    },
    "AppState": {
      "title": "AppState",
      "description": "Stores a specific slice of the user's application state.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The user ID this state belongs to."
        },
        "stateKey": {
          "type": "string",
          "description": "The key identifier of the state slice (e.g., profile, sekolah, tigab, menu, foodCost, tkpi, customLogo)."
        },
        "data": {
          "type": "string",
          "description": "The JSON-stringified state data value."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when this state slice was last updated."
        }
      },
      "required": ["userId", "stateKey", "data", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Main user account record."
    },
    "/users/{userId}/states/{stateKey}": {
      "schema": "AppState",
      "description": "Sub-collection storing serialized application states to prevent cache clear losses."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": "DeviceSession",
      "description": "Sub-collection tracking all devices linked to a specific user."
    },
    "/devices/{deviceId}": {
      "schema": "DeviceSession",
      "description": "Top-level real-time device registry read automatically by Admin Panel."
    }
  }
}
