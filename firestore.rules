rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Auth & Validation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmailLower() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isVerifiedAuth() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    // Allows Google Sign-In tenants (including Google accounts linked to external domains) to self-register as pending USER
    function isGoogleOrVerifiedAuth() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && (
          (('email_verified' in request.auth.token) && request.auth.token.email_verified == true)
          || (
            ('firebase' in request.auth.token)
            && ('sign_in_provider' in request.auth.token.firebase)
            && request.auth.token.firebase.sign_in_provider == 'google.com'
          )
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMainAdminToken() {
      return isVerifiedAuth()
        && authEmailLower() in [
          'syukriyusuf82@gmail.com',
          'sukriyusuf82@gmail.com',
          'syukriyusuf00@gmail.com'
        ];
    }

    function isAdmin() {
      return isMainAdminToken()
        || (
          isVerifiedAuth()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && ('peran' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.peran == 'ADMIN'
        );
    }

    // Allows first-time Google login migration ONLY if Admin already pre-approved an active sheet_user_* record for the exact same verified email
    function hasApprovedSheetMigration(data) {
      return isVerifiedAuth()
        && ('migratedFromDocId' in data)
        && data.migratedFromDocId is string
        && data.migratedFromDocId.matches('^sheet_user_[a-z0-9_]+$')
        && exists(/databases/$(database)/documents/users/$(data.migratedFromDocId))
        && ('email' in get(/databases/$(database)/documents/users/$(data.migratedFromDocId)).data)
        && get(/databases/$(database)/documents/users/$(data.migratedFromDocId)).data.email is string
        && get(/databases/$(database)/documents/users/$(data.migratedFromDocId)).data.email.lower() == authEmailLower()
        && ('statusPersetujuan' in get(/databases/$(database)/documents/users/$(data.migratedFromDocId)).data)
        && get(/databases/$(database)/documents/users/$(data.migratedFromDocId)).data.statusPersetujuan == 'aktif';
    }

    // 3. Strict User Self-Create & Self-Update Validators (Explicit static checks — zero runtime evaluation traps)
    function isValidUserFieldBounds(data) {
      return ('email' in data) && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && (!('namaLengkap' in data) || data.namaLengkap == null || (data.namaLengkap is string && data.namaLengkap.size() <= 160))
        && (!('profesi' in data) || data.profesi == null || (data.profesi is string && data.profesi.size() <= 120))
        && (!('namaSPPG' in data) || data.namaSPPG == null || (data.namaSPPG is string && data.namaSPPG.size() <= 160))
        && (!('noHp' in data) || data.noHp == null || (data.noHp is string && data.noHp.size() <= 40))
        && (!('mulaiPada' in data) || data.mulaiPada == null || (data.mulaiPada is string && data.mulaiPada.size() <= 32))
        && (!('berakhirPada' in data) || data.berakhirPada == null || (data.berakhirPada is string && data.berakhirPada.size() <= 32))
        && (!('keterangan' in data) || data.keterangan == null || (data.keterangan is string && data.keterangan.size() <= 300))
        && (!('sumber' in data) || data.sumber == null || (data.sumber is string && data.sumber.size() <= 64))
        && (!('lastDeviceId' in data) || data.lastDeviceId == null || (data.lastDeviceId is string && data.lastDeviceId.size() <= 64))
        && (!('lastDeviceLabel' in data) || data.lastDeviceLabel == null || (data.lastDeviceLabel is string && data.lastDeviceLabel.size() <= 160))
        && (!('loginCount' in data) || (data.loginCount is number && data.loginCount >= 0 && data.loginCount <= 1000000));
    }

    function isValidUserSelfCreate(userId, data) {
      return isGoogleOrVerifiedAuth()
        && isValidId(userId)
        && isValidUserFieldBounds(data)
        && ('uid' in data) && data.uid == userId
        && data.email.lower() == authEmailLower()
        && ('peran' in data) && data.peran == 'USER'
        && ('statusPersetujuan' in data)
        && (
          (
            data.statusPersetujuan == 'menunggu'
            && (!('mulaiPada' in data) || data.mulaiPada == null || data.mulaiPada == '')
            && (!('berakhirPada' in data) || data.berakhirPada == null || data.berakhirPada == '')
            && (!('keterangan' in data) || data.keterangan == null || data.keterangan in ['', 'Daftar Tunggu - Menunggu ACC Admin Odhe Gizi'])
          )
          || (data.statusPersetujuan == 'aktif' && hasApprovedSheetMigration(data))
        );
    }

    function isSafeSelfRoleTransition(next, prev) {
      return (!('peran' in prev) || prev.peran == null || prev.peran == '')
        ? (('peran' in next) && next.peran == 'USER')
        : (('peran' in next) && next.peran == prev.peran);
    }

    function isSafeSelfStatusTransition(next, prev) {
      return (!('statusPersetujuan' in prev) || prev.statusPersetujuan == null || prev.statusPersetujuan == '' || prev.statusPersetujuan == 'pending')
        ? (('statusPersetujuan' in next) && next.statusPersetujuan == 'menunggu')
        : (('statusPersetujuan' in next) && next.statusPersetujuan == prev.statusPersetujuan);
    }

    function isMulaiPadaUnchanged(next, prev) {
      return (!('mulaiPada' in prev) || prev.mulaiPada == null || prev.mulaiPada == '')
        ? (!('mulaiPada' in next) || next.mulaiPada == null || next.mulaiPada == '')
        : (('mulaiPada' in next) && next.mulaiPada == prev.mulaiPada);
    }

    function isBerakhirPadaUnchanged(next, prev) {
      return (!('berakhirPada' in prev) || prev.berakhirPada == null || prev.berakhirPada == '')
        ? (!('berakhirPada' in next) || next.berakhirPada == null || next.berakhirPada == '')
        : (('berakhirPada' in next) && next.berakhirPada == prev.berakhirPada);
    }

    function isKeteranganUnchanged(next, prev) {
      return (!('keterangan' in prev) || prev.keterangan == null || prev.keterangan == '')
        ? (!('keterangan' in next) || next.keterangan == null || next.keterangan in ['', 'Daftar Tunggu - Menunggu ACC Admin Odhe Gizi'])
        : (('keterangan' in next) && next.keterangan == prev.keterangan);
    }

    function isValidUserSelfUpdate(userId, next, prev) {
      return isGoogleOrVerifiedAuth()
        && isValidId(userId)
        && isValidUserFieldBounds(next)
        && ('uid' in next) && next.uid == userId
        && next.email.lower() == authEmailLower()
        && (!('email' in prev) || prev.email == null || prev.email == '' || next.email.lower() == prev.email.lower())
        && isSafeSelfRoleTransition(next, prev)
        && isSafeSelfStatusTransition(next, prev)
        && isMulaiPadaUnchanged(next, prev)
        && isBerakhirPadaUnchanged(next, prev)
        && isKeteranganUnchanged(next, prev);
    }

    // 4. Device Telemetry Payload Validator
    function isValidDevicePayload(deviceId, data) {
      return isValidId(deviceId)
        && data.keys().hasAll(['deviceId', 'deviceType', 'osName', 'browserName', 'sessionState', 'lastSeenAt'])
        && data.keys().hasOnly([
          'deviceId', 'deviceType', 'deviceModel', 'osName', 'browserName',
          'screenResolution', 'viewportSize', 'language', 'timezone', 'ipAddress',
          'userAgent', 'sessionState', 'userUid', 'userEmail', 'userName',
          'namaSPPG', 'peran', 'statusPersetujuan', 'isOnline', 'firstSeenAt',
          'lastSeenAt', 'updatedAt'
        ])
        && data.deviceId == deviceId
        && data.deviceId is string && data.deviceId.size() <= 64
        && data.deviceType is string && data.deviceType in ['Mobile', 'Tablet', 'Desktop / Laptop']
        && data.osName is string && data.osName.size() <= 80
        && data.browserName is string && data.browserName.size() <= 80
        && data.sessionState is string && data.sessionState in ['guest', 'registering', 'active', 'demo']
        && data.lastSeenAt is string && data.lastSeenAt.size() <= 64
        && (!('deviceModel' in data) || data.deviceModel == null || (data.deviceModel is string && data.deviceModel.size() <= 100))
        && (!('screenResolution' in data) || data.screenResolution == null || (data.screenResolution is string && data.screenResolution.size() <= 40))
        && (!('viewportSize' in data) || data.viewportSize == null || (data.viewportSize is string && data.viewportSize.size() <= 40))
        && (!('language' in data) || data.language == null || (data.language is string && data.language.size() <= 32))
        && (!('timezone' in data) || data.timezone == null || (data.timezone is string && data.timezone.size() <= 80))
        && (!('ipAddress' in data) || data.ipAddress == null || (data.ipAddress is string && data.ipAddress.size() <= 64))
        && (!('userAgent' in data) || data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 320))
        && (!('userUid' in data) || data.userUid == null || (data.userUid is string && data.userUid.size() <= 128))
        && (!('userEmail' in data) || data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 256))
        && (!('userName' in data) || data.userName == null || (data.userName is string && data.userName.size() <= 160))
        && (!('namaSPPG' in data) || data.namaSPPG == null || (data.namaSPPG is string && data.namaSPPG.size() <= 160))
        && (!('peran' in data) || data.peran == null || (data.peran is string && data.peran.size() <= 32))
        && (!('statusPersetujuan' in data) || data.statusPersetujuan == null || (data.statusPersetujuan is string && data.statusPersetujuan.size() <= 32))
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('firstSeenAt' in data) || data.firstSeenAt == null || (data.firstSeenAt is string && data.firstSeenAt.size() <= 64));
    }

    // 5. Connectivity Probe
    match /test/connection {
      allow get: if true;
    }

    // 6. Admin Settings & Global Configuration Collections
    match /configs/app_logo {
      // Publicly readable so the global app logo appears automatically on the login screen
      allow get: if true;
      allow create, update, delete: if isAdmin();
    }

    match /configs/{configId} {
      // Signed-in users can read sync config doc; only Admin can list or modify admin settings
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(configId);
    }

    match /global_settings/{settingId} {
      // Shared nutrition reference settings (e.g. TKPI) readable by app sessions; writable only by Admin
      allow get: if isValidId(settingId);
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // 7. Real-Time Device Registry (Write heartbeat validated; listing & deletion restricted to Admin)
    match /devices/{deviceId} {
      allow get, delete: if isValidId(deviceId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(deviceId) && isValidDevicePayload(deviceId, incoming());
    }

    // 8. User Access Control Records & Isolated Tenant Workspaces
    match /users/{userId} {
      // Listing all users is strictly Admin-only (prevents PII harvesting)
      allow list: if isAdmin();
      // Evaluate isOwner FIRST so non-admin users never incur or trip on Admin doc lookups
      allow get: if isValidId(userId) && (
        isOwner(userId)
        || isAdmin()
        || (isVerifiedAuth() && resource != null && ('email' in resource.data) && resource.data.email is string && resource.data.email.lower() == authEmailLower())
      );
      allow create: if isValidId(userId) && (
        (isOwner(userId) && isValidUserSelfCreate(userId, incoming()))
        || isAdmin()
      );
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUserSelfUpdate(userId, incoming(), existing()))
        || isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin();

      match /states/{stateKey} {
        allow get, list: if isValidId(userId) && isValidId(stateKey) && (isOwner(userId) || isAdmin());
        allow create, update: if isValidId(userId) && isValidId(stateKey)
          && (isOwner(userId) || isAdmin())
          && (!('userId' in incoming()) || incoming().userId == userId)
          && (!('stateKey' in incoming()) || incoming().stateKey == stateKey)
          && (!('data' in incoming()) || (incoming().data is string && incoming().data.size() <= 950000));
        allow delete: if isValidId(userId) && isValidId(stateKey) && (isOwner(userId) || isAdmin());
      }

      match /devices/{deviceId} {
        allow read, write: if isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
